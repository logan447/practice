---
// Base layout: draft banner, header + mobile drawer, full-width footer,
// optional sticky mobile Book bar (shows after the element with
// id="bookbar-after").
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  bookbar?: boolean;
}
const { title, description = 'Unhurried direct primary care by a physician who knows you. $100 a month, cancel anytime, works alongside your insurance.', active = '', bookbar = false } = Astro.props;

const nav = [
  { key: 'help', href: '/help', label: 'What I help with' },
  { key: 'how', href: '/how-it-works', label: 'How it works' },
  { key: 'pricing', href: '/pricing', label: 'Pricing' },
  { key: 'about', href: '/about', label: 'About' },
  { key: 'writing', href: '/writing', label: 'Research & writing' },
  { key: 'questions', href: '/questions', label: 'Questions' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container">
        <div class="bar">
          <a class="wordmark" href="/">DuBose, M.D.<small>direct primary care</small></a>
          <nav class="nav-desktop" aria-label="Main">
            {nav.map((n) => (
              <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
            ))}
            <a class="login-link" href="/login">Patient login</a>
            <a class="btn btn-nav" href="/book">Book a free conversation</a>
          </nav>
          <div class="nav-toggle">
            <a class="btn btn-nav" href="/book">Book</a>
            <label for="nav-check" aria-label="Open menu">&#9776;</label>
          </div>
        </div>
        <input type="checkbox" id="nav-check" aria-hidden="true" />
        <nav class="drawer" aria-label="Mobile">
          <a href="/help" class={active === 'help' ? 'active' : ''}>What I help with</a>
          <a href="/how-it-works" class={active === 'how' ? 'active' : ''}>How it works</a>
          <a href="/pricing" class={active === 'pricing' ? 'active' : ''}>Pricing</a>
          <a href="/about" class={active === 'about' ? 'active' : ''}>About Dr. DuBose</a>
          <a href="/writing" class={active === 'writing' ? 'active' : ''}>Research &amp; writing</a>
          <a href="/questions" class={active === 'questions' ? 'active' : ''}>Questions</a>
          <a class="btn" href="/book">Book a free conversation</a>
          <a href="/login" style="font-weight:400;color:var(--soft);font-size:16px">Patient login</a>
          <p class="em-line">If this is an emergency, call 911 or go to the nearest ER.</p>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <div>
            <div class="fm">DuBose, M.D.<small>direct primary care</small></div>
            <p style="margin-top:16px;max-width:30ch">
              One doctor, a small panel, and enough time. [City], Texas.
            </p>
          </div>
          <nav aria-label="Footer">
            <h5>Explore</h5>
            <a href="/help">What I help with</a>
            <a href="/how-it-works">How it works</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About Dr. DuBose</a>
            <a href="/writing">Research &amp; writing</a>
            <a href="/referrals">For clinicians</a>
          </nav>
          <nav aria-label="For patients">
            <h5>For patients</h5>
            <a href="/book">Book a conversation</a>
            <a href="/login">Patient login</a>
            <a href="/agreement">Membership agreement</a>
            <a href="/contact">Contact</a>
          </nav>
          <div class="nl">
            <h5>Newsletter</h5>
            <form action="#" method="post">
              <input type="email" name="email" placeholder="email address" aria-label="Email address" required />
              <button class="btn" type="submit">Sign up</button>
            </form>
          </div>
        </div>
        <div class="legal">
          <span>&copy; 2026 DuBose, M.D. &middot; Logan L. DuBose, M.D.</span>
          <span>Not health insurance &middot; a direct primary care agreement under Texas law</span>
          <span>Emergencies: call 911</span>
        </div>
      </div>
    </footer>

    {bookbar && (
      <div class="bookbar">
        <a class="btn" href="/book">Book a free conversation</a>
      </div>
    )}
    {bookbar && (
      <script is:inline>
        (function () {
          var b = document.querySelector('.bookbar');
          var top = document.querySelector('.hero') || document.querySelector('.page-title');
          var end = document.querySelector('.cta-band') || document.querySelector('.site-footer');
          if (!b || !top) return;
          function update() {
            var past = top.getBoundingClientRect().bottom < 0;
            var nearEnd = end && end.getBoundingClientRect().top < window.innerHeight;
            b.classList.toggle('show', past && !nearEnd);
          }
          addEventListener('scroll', update, { passive: true });
          update();
        })();
      </script>
    )}
  </body>
</html>
