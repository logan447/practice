---
import Base from '../layouts/Base.astro';
// Web rendering of the physician's CV. Facts transcribed from the source
// CV plus updates confirmed 2026-08: Texas A&M affiliate appointment
// ended July 2026; FCHC role is now employed primary care (no longer
// volunteer); IBLM certification expected January 2027; ACLM member
// August 2026; e92967 published in JMIR Formative Research. Personal
// contact details are intentionally omitted from this public page.
---
<Base title="Curriculum Vitae · Direct Lifestyle Medicine">
  <section class="page-title">
    <div class="container">
      <h1>Logan L. DuBose, M.D., M.B.A.</h1>
      <p class="lede">Current as of August 2026.
      <a class="quiet" href="https://orcid.org/0009-0005-2740-9062">ORCID profile &rarr;</a></p>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(24px,3vw,40px) clamp(48px,6vw,72px)">
    <div class="container">

      <div class="doc-sec" style="border-top:none;padding-top:0">
        <div class="sh"><h2>Experience</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Primary Care Physician</b>
            <span class="org">Fredericksburg Christian Health Center; Fredericksburg, VA</span>
            <span class="dates">2026 to present</span></p>
          <p class="cvitem"><b>Chief Research Officer</b>
            <span class="org">Olera, Inc.; Austin, TX</span>
            <span class="dates">2023 to present</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Faculty appointments</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Affiliate Faculty</b>
            <span class="org">Texas A&amp;M School of Public Health, Center for Community Health and Aging; College Station, TX</span>
            <span class="dates">August 2022 to July 2026</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Training</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Internship, Internal Medicine</b>
            <span class="org">George Washington University; Washington, DC</span>
            <span class="dates">2022 to 2023</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Education</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Doctor of Medicine (M.D.)</b>
            <span class="org">Texas A&amp;M Health Science Center College of Medicine; College Station, TX</span>
            <span class="dates">2017 to 2022</span></p>
          <p class="cvitem"><b>Master of Business Administration (M.B.A.)</b>
            <span class="org">Mays Business School, Texas A&amp;M University; College Station, TX</span>
            <span class="dates">2020 to 2021</span></p>
          <p class="cvitem"><b>Bachelor of Science and Arts, Biochemistry</b>
            <span class="org">The University of Texas at Austin</span>
            <span class="dates">2013 to 2017</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Licensure</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Virginia Medical License</b>
            <span class="org">Virginia Board of Medicine</span>
            <span class="dates">2026 to present</span></p>
          <p class="cvitem"><b>DEA Registration (Virginia)</b>
            <span class="org">U.S. Drug Enforcement Administration</span>
            <span class="dates">2026 to present</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Certification and membership</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Lifestyle Medicine Board Certification</b>
            <span class="org">International Board of Lifestyle Medicine</span>
            <span class="dates">In progress</span></p>
          <p class="cvitem"><b>Member</b>
            <span class="org">American College of Lifestyle Medicine</span>
            <span class="dates">August 2026 to present</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Research grants</h2></div>
        <div class="sc">
          <p class="cvitem"><b>NIH National Institute on Aging, SBIR Fast-Track Award; Co-Investigator (Research Lead)</b>
            <span class="org">Olera CareNavigator. $2,961,117</span>
            <span class="dates">2024 to 2027</span></p>
          <p class="cvitem"><b>NIH National Institute on Aging, SBIR Fast-Track Award; Co-Investigator (Research Lead)</b>
            <span class="org">Olera online platform for dementia caregivers. $2,259,663</span>
            <span class="dates">2021 to 2024</span></p>
          <p class="cvitem"><b>NIH Innovation Corps (I-Corps) Program for Translational Research; Co-Investigator (Research Lead)</b>
            <span class="org">$55,000</span>
            <span class="dates">2022</span></p>
          <p class="cvitem"><b>NSF Innovation Corps (I-Corps) Translational Research Program; Research Lead</b>
            <span class="org">$50,000</span>
            <span class="dates">2021</span></p>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Publications</h2></div>
        <div class="sc">
          <div class="pubs" style="max-width:none">
          <p class="pub"><b>Exploring Informal Caregivers&rsquo; Perception of the Olera Digital Caregiving Assistance Platform for Dementia Care</b> JMIR Formative Research, 2026. <a href="https://doi.org/10.2196/92967">doi:10.2196/92967</a></p>
          <p class="pub"><b>Understanding Older Adults&rsquo; Perceptions of AI Use in Financial Decisions</b> Senior author. Human Factors in Aging and Special Needs, 2025. <a href="https://doi.org/10.54941/ahfe1006290">doi:10.54941/ahfe1006290</a></p>
          <p class="pub"><b>A Virtual Reality Intervention to Reduce Death Anxiety and Stress in Adults</b> Frontiers in Virtual Reality, 2025. <a href="https://doi.org/10.3389/frvir.2025.1644131">doi:10.3389/frvir.2025.1644131</a></p>
          <p class="pub"><b>Development and Evaluation of a Web-Based Platform for Dementia Caregivers: Proposal for a Mixed Methods Study</b> First author. JMIR Research Protocols, 2024. <a href="https://doi.org/10.2196/64127">doi:10.2196/64127</a></p>
          <p class="pub"><b>The Olera.care Digital Caregiving Assistance Platform for Dementia Caregivers: Preliminary Evaluation Study</b> JMIR Aging, 2024. <a href="https://doi.org/10.2196/55132">doi:10.2196/55132</a></p>
          <p class="pub"><b>Financial, Legal, and Functional Challenges of Providing Care for People Living With Dementia</b> Co-first author. JMIR Aging, 2023. <a href="https://doi.org/10.2196/47577">doi:10.2196/47577</a></p>
          <p class="pub"><b>Medical Trainees&rsquo; Perspectives and Use of Humor in Clinical Settings: A Systematic Review</b> Plastic and Reconstructive Surgery Global Open, 2022. <a href="https://doi.org/10.1097/01.GOX.0000834956.67576.36">doi:10.1097/01.GOX.0000834956.67576.36</a></p>
          <p class="pub"><b>E-cigarette, or Vaping, Associated Lung and Hepatic Injury</b> Journal of Pediatric Gastroenterology and Nutrition, 2020. <a href="https://doi.org/10.1097/MPG.0000000000002744">doi:10.1097/MPG.0000000000002744</a></p>
          </div>
        </div>
      </div>

      <div class="doc-sec">
        <div class="sh"><h2>Service</h2></div>
        <div class="sc">
          <p class="cvitem"><b>Medical Volunteer Physician and Board Member</b>
            <span class="org">Project Belize; Punta Gorda, Belize</span>
            <span class="dates">2019, 2026</span></p>
        </div>
      </div>

    </div>
  </section>
</Base>
