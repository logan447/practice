---
import Base from '../layouts/Base.astro';
// When the EHR patient portal exists (X-03 selection), set PORTAL_URL and
// the button below goes straight to it.
const PORTAL_URL = ''; // e.g. 'https://portal.example.com' at launch
---
<Base title="Patient login · DuBose, M.D.">
  <section class="section">
    <div class="container">
      <div class="split even" style="align-items:start">
        <div class="prose">
          <span class="eyebrow">For current patients</span>
          <h1 style="font-size:clamp(30px,4vw,44px)">Patient login</h1>
          <p style="margin-top:18px">
            Sign in to message me, see your results and my explanations,
            and manage visits.
          </p>
          {PORTAL_URL ? (
            <p style="margin-top:24px"><a class="btn" href={PORTAL_URL}>Go to the portal</a></p>
          ) : (
            <p style="margin-top:24px" class="soft">
              The portal opens with the practice. This page will be the
              sign-in link.
            </p>
          )}
          <p class="small soft" style="margin-top:28px">
            The portal is never for emergencies. Call 911 or go to the
            nearest ER.
          </p>
        </div>
        <div class="card" style="padding:32px">
          <h3>Not a patient yet?</h3>
          <p style="margin-top:10px">
            Start with a free conversation. Thirty minutes by video, no
            commitment.
          </p>
          <p style="margin-top:22px"><a class="btn" href="/book">Book a free conversation</a></p>
          <p style="margin-top:16px"><a class="quiet" href="/how-it-works">How the practice works &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
