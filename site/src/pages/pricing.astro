---
import Base from '../layouts/Base.astro';
---
<Base title="Pricing · Direct Lifestyle Medicine" active="pricing" bookbar={true}>

  <!-- 1 · Intro -->
  <section class="page-title">
    <div class="container">
      <h1>Pricing</h1>
    </div>
  </section>

  <!-- 2 · Price and fee levels -->
  <section class="section band-tint">
    <div class="container">
      <div class="split even" style="align-items:start">
        <div class="price-card">
          <div class="amt">$99 <span>per month</span></div>
          <div class="per">per adult &middot; no per-visit charges</div>
          <ul class="check-list">
            <li>Assessment and written plan</li>
            <li>Visits by video, at home, or in a clinic</li>
            <li>Messages, answered in 1&ndash;2 business days</li>
            <li>Results explained</li>
            <li>Treatment and prescriptions within my scope</li>
            <li>Referrals and coordination</li>
            <li>Forms and paperwork</li>
          </ul>
          <p class="small" style="margin-bottom:20px;color:var(--soft)">
            No enrollment fee or contract. Cancel anytime, effective at
            the end of the month.
          </p>
          <a class="btn" href="/book">Book a free conversation</a>
        </div>
        <div>
          <h2>Three fee levels, the same care</h2>
          <div class="rows" style="margin-top:clamp(24px,3vw,34px)">
            <div class="row"><b>Standard</b><p>$99 a month per adult.</p></div>
            <div class="row"><b>Sliding scale</b><p>A reduced fee based on your finances. No application.</p></div>
            <div class="row"><b>Pro bono</b><p>Free. A limited number.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Not included -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>Not included</h2>
          <p class="lede">Keep your health insurance for these.</p>
        </div>
        <div class="rows" style="margin-top:0">
          <div class="row"><b>Labs</b><p>Insurance, or a discounted cash price passed through at my cost.</p></div>
          <div class="row"><b>Medicines</b><p>Your pharmacy.</p></div>
          <div class="row"><b>Imaging, specialists, urgent care, ER, hospital</b><p>Insurance.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Coverage -->
  <section class="section band-warm" id="bookbar-after">
    <div class="container">
      <div class="split">
        <div>
          <h2>Insurance</h2>
          <p class="lede">I do not bill insurance, Medicare, or Medicaid.</p>
        </div>
        <div class="rows" style="margin-top:0">
          <div class="row"><b>Medicare or Medicaid</b><p>Not settled yet. Ask me.</p></div>
          <div class="row"><b>HSA and FSA</b><p>Not settled yet. Ask your tax advisor.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Limits -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>Limits</h2>
        </div>
        <div class="prose">
          <p>
            Business hours only. Not an emergency service. I take time
            away each year. When my panel is full, it is full.
          </p>
          <p><a class="quiet" href="/agreement">Membership agreement &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

</Base>
