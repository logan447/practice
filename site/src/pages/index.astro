---
import Base from '../layouts/Base.astro';
---
<Base title="Direct Lifestyle Medicine · Logan DuBose, M.D." bookbar={true}>

  <!-- 1 · Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="h-head">
          <span class="eyebrow">Lifestyle medicine &middot; [City], Texas</span>
          <h1>Prevention first, with medical care when you need it.</h1>
        </div>
        <div class="h-photo">
          <div class="photo-frame">
            <div class="photo" style="aspect-ratio:4/5">
              <img src="/images/dr-dubose.jpg" alt="Dr. Logan DuBose" width="800" height="1000" />
            </div>
          </div>
        </div>
        <div class="h-body">
          <p class="sub">
            I&rsquo;m Logan DuBose, a physician. You do not need another
            doctor to join.
          </p>
          <div class="cta-row">
            <a class="btn" href="/book">Book a free conversation</a>
            <a class="quiet" href="/how-it-works">How it works &rarr;</a>
          </div>
        </div>
      </div>
      <div class="pstrip">
        <div><b>$99 a month</b>no per-visit charges</div>
        <div><b>Reduced and free memberships</b>same care</div>
        <div><b>Adults only</b>business hours, not emergencies</div>
      </div>
    </div>
  </section>

  <!-- 2 · The three services -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <h2>What I do</h2>
      </div>
      <div class="cards c3">
        <div class="card">
          <h4>Prevention and lifestyle medicine</h4>
          <p>Food, activity, sleep, stress, alcohol, and tobacco.
          Screenings. A written plan.</p>
        </div>
        <div class="card">
          <h4>Medical care</h4>
          <p>Diagnosis, labs, imaging, prescriptions, and follow-up.</p>
        </div>
        <div class="card">
          <h4>Care coordination</h4>
          <p>Referrals, and contact with your other doctors.</p>
        </div>
      </div>
      <p style="margin-top:36px"><a class="quiet" href="/help">What I help with &rarr;</a></p>
    </div>
  </section>

  <!-- 3 · How it works -->
  <section class="section band-warm" id="bookbar-after">
    <div class="container">
      <div class="sec-head">
        <h2>How it works</h2>
      </div>
      <div class="steps">
        <div class="step-item">
          <span class="num">01</span>
          <h4>Free conversation</h4>
          <p>30 minutes by video.</p>
        </div>
        <div class="step-item">
          <span class="num">02</span>
          <h4>Join</h4>
          <p>$99 a month. No contract.</p>
        </div>
        <div class="step-item">
          <span class="num">03</span>
          <h4>Assessment and plan</h4>
          <p>A full first visit, then a written plan.</p>
        </div>
        <div class="step-item">
          <span class="num">04</span>
          <h4>Follow-up</h4>
          <p>Visits and messages as needed.</p>
        </div>
      </div>
      <p style="margin-top:36px"><a class="quiet" href="/pricing">Pricing &rarr;</a></p>
    </div>
  </section>

  <!-- 4 · Fit -->
  <section class="section">
    <div class="container">
      <div class="fit">
        <div>
          <h3>A good fit if you&hellip;</h3>
          <ul class="yes">
            <li>want to prevent problems</li>
            <li>want help with sleep, weight, food, activity, or stress</li>
            <li>have ongoing conditions to manage</li>
          </ul>
        </div>
        <div>
          <h3>Not a fit if you&hellip;</h3>
          <ul class="no">
            <li>need 24/7 or emergency care</li>
            <li>need every condition managed by one doctor</li>
            <li>are under 18</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Closing -->
  <section class="section cta-band">
    <div class="container">
      <div class="inner">
        <h2>Start with a free conversation.</h2>
        <a class="btn btn-inverse" href="/book">Book a free conversation</a>
      </div>
    </div>
  </section>

</Base>
