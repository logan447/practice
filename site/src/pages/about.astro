---
import Base from '../layouts/Base.astro';
---
<Base title="About Dr. DuBose · Direct Lifestyle Medicine" active="about">

  <!-- 1 · Introduction -->
  <section class="section" style="padding-block:clamp(56px,8vw,96px)">
    <div class="container">
      <div class="about-grid">
        <div class="photo-frame">
          <div class="photo" style="aspect-ratio:4/5">
            <img src="/images/dr-dubose.jpg" alt="Dr. Logan DuBose" width="800" height="1000" />
          </div>
        </div>
        <div class="prose">
          <h1 style="font-size:clamp(30px,4vw,44px)">Logan DuBose, M.D.</h1>
          <p style="margin-top:20px">
            Physician and researcher. I practice lifestyle medicine and
            lead NIH-funded research on aging and caregiving.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Training and credentials -->
  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>Credentials</h2>
          <p style="margin-top:18px"><a class="quiet" href="/cv">CV &rarr;</a></p>
        </div>
        <div class="rows" style="margin-top:0">
        <div class="row"><b>M.D.</b><p>Texas A&amp;M College of Medicine</p></div>
        <div class="row"><b>Internship</b><p>Internal medicine, George Washington University</p></div>
        <div class="row"><b>Licensure</b><p>Virginia, DEA-registered; Texas [at launch]</p></div>
        <div class="row"><b>Practice</b><p>Primary care physician, Fredericksburg Christian Health Center</p></div>
        <div class="row"><b>Research</b><p>Chief Research Officer, Olera</p></div>
        <div class="row"><b>In progress</b><p>Lifestyle medicine board certification, International Board of Lifestyle Medicine</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · How I practice -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>How I practice</h2>
        </div>
        <div class="rows" style="margin-top:0">
        <div class="row"><b>Evidence first</b><p>When the evidence is thin, I say so.</p></div>
        <div class="row"><b>Lifestyle first</b><p>Medicine when it is needed.</p></div>
        <div class="row"><b>Your decisions are yours</b><p>I explain my reasoning.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · CTA -->
  <section class="section cta-band">
    <div class="container">
      <div class="inner">
        <a class="btn btn-inverse" href="/book">Book a free conversation</a>
      </div>
    </div>
  </section>

</Base>
