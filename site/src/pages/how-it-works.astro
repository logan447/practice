---
import Base from '../layouts/Base.astro';
import EmergencyStrip from '../components/EmergencyStrip.astro';

// Thin-stroke line icons (Lucide-derived paths, 1.5px stroke) — design rule 1: never emoji.
const icon = {
  video: 'M15.6 10.3l4.4-2.5v8.4l-4.4-2.5M4 6.8h9.6a2 2 0 0 1 2 2v6.4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.8a2 2 0 0 1 2-2z',
  home: 'M3 10.5L12 3l9 7.5M5.5 8.8V20h13V8.8M9.8 20v-6h4.4v6',
  clinic: 'M4 20V6.5L12 3l8 3.5V20M4 20h16M12 8v6M9 11h6',
  message: 'M21 12a8 8 0 0 1-8 8H4l1.7-3.4A8 8 0 1 1 21 12z',
  file: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5zM14 3v5h5M9 13h6M9 17h6',
  rx: 'M7 4h5a3.5 3.5 0 0 1 0 7H7V4zM7 11v9M10 13l7 7M17 13l-7 7',
};
---
<Base title="How it works · Direct Lifestyle Medicine" active="how" bookbar={true}>

  <!-- 1 · Intro -->
  <section class="page-title">
    <div class="container">
      <h1>How it works</h1>
      <p class="lede">One membership. No packages. The care is the same at
      every fee level.</p>
    </div>
  </section>

  <!-- 2 · Your first 90 days -->
  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>Your first 90 days</h2>
        </div>
        <div class="timeline">
          <div class="tl-item">
            <h3>First: a free conversation</h3>
            <p>
              Thirty minutes by video. You tell me what&rsquo;s going on,
              and I tell you if I can help. If it fits, you join. If not,
              there is no bill.
            </p>
          </div>
          <div class="tl-item">
            <h3>Weeks 1&ndash;2: I read your records, then we meet</h3>
            <p>
              If you have records, I request and read them first. Then
              your first full visit: up to 90 minutes for your history,
              medicines, conditions, concerns, and the way you live. I
              also ask which other doctors you see, if any.
            </p>
          </div>
          <div class="tl-item">
            <h3>Weeks 2&ndash;4: we fill in the picture</h3>
            <p>
              Screenings that are due. Labs if we need them. I tell you
              the cash price first, or we use your insurance. An exam at
              your home or the clinic if needed. Every result comes back
              explained.
            </p>
          </div>
          <div class="tl-item">
            <h3>Around week 4: you have a plan</h3>
            <p>
              A short written plan in your portal: what we&rsquo;re
              working on, in what order, who does what, and when we check
              progress. It covers the lifestyle work and any treatment
              we have agreed on.
            </p>
          </div>
          <div class="tl-item">
            <h3>Then: a rhythm that fits you</h3>
            <p>
              Some patients meet every two weeks. Some check in monthly
              or every few months. There is no set schedule and no
              per-visit charge. At about 90 days, we review how it&rsquo;s
              going and adjust.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · How I work on your health -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <h2>How I work on your health</h2>
        <p class="lede">The same steps, whatever we are working on.</p>
      </div>
      <div class="loop">
        <div class="lnode"><b>Understand</b><span>where you are</span></div>
        <div class="lnode"><b>Prioritize</b><span>what matters most</span></div>
        <div class="lnode"><b>Plan</b><span>built together</span></div>
        <div class="lnode"><b>Work</b><span>habits, treatment, visits, messages</span></div>
        <div class="lnode"><b>Measure</b><span>blood pressure, labs, how you feel</span></div>
        <div class="lnode"><b>Adjust</b><span>as life changes</span></div>
      </div>
    </div>
  </section>

  <!-- 4 · Where we meet -->
  <section class="section band-tint">
    <div class="container">
      <div class="sec-head">
        <h2>Where we meet</h2>
        <p class="lede">By video, at your home, or in person when needed.</p>
      </div>
      <div class="cards c3">
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.video} /></svg>
          </div>
          <h4>By video, most of the time</h4>
          <p>
            Most visits are by video, from wherever you are.
          </p>
        </div>
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.home} /></svg>
          </div>
          <h4>At your home, when an exam needs it</h4>
          <p>
            When you need a hands-on exam, I can come to you. Scheduled
            ahead, within my service area, at no extra charge.
          </p>
        </div>
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.clinic} /></svg>
          </div>
          <h4>In a clinic, when you need one</h4>
          <p>For exams and procedures that need an equipped room.
          Scheduled as needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Between visits -->
  <section class="section band-warm">
    <div class="container">
      <div class="sec-head">
        <h2>Between visits</h2>
      </div>
      <div class="steps c3">
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.message} /></svg>
          </div>
          <h4>Message me directly</h4>
          <p>
            A question, a symptom, a pharmacy problem. Send it through
            the secure portal. I answer within 1&ndash;2 business days,
            often sooner.
          </p>
        </div>
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.file} /></svg>
          </div>
          <h4>Results explained</h4>
          <p>
            Every result comes with my note: what it means and what we
            do next.
          </p>
        </div>
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.rx} /></svg>
          </div>
          <h4>Refills</h4>
          <p>
            I renew prescriptions I write at your visits. If one runs
            out, message me.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Availability -->
  <section class="section" id="bookbar-after">
    <div class="container">
      <div class="split">
        <div>
          <h2>When I&rsquo;m available</h2>
        </div>
        <div class="prose">
          <p>
            I keep business hours, Monday through Friday. I don&rsquo;t
            offer nights, weekends, or 24/7 access.
          </p>
          <p>
            I also take real time away each year. You&rsquo;ll know in
            advance. I still check incoming results and messages for
            anything important. Away means slower, never unaware. Urgent
            needs follow the same rules:
          </p>
          <EmergencyStrip />
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · CTA -->
  <section class="section cta-band">
    <div class="container">
      <div class="inner">
        <h2>Ready to see if this fits?</h2>
        <a class="btn btn-inverse" href="/book">Book a free conversation</a>
        <p style="margin-top:20px"><a class="quiet" href="/agreement">Or read the membership agreement first &rarr;</a></p>
      </div>
    </div>
  </section>

</Base>
