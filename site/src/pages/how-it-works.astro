---
import Base from '../layouts/Base.astro';
import EmergencyStrip from '../components/EmergencyStrip.astro';

// Thin-stroke line icons (Lucide-derived paths, 1.5px stroke) — design rule 1: never emoji.
const icon = {
  video: 'M15.6 10.3l4.4-2.5v8.4l-4.4-2.5M4 6.8h9.6a2 2 0 0 1 2 2v6.4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.8a2 2 0 0 1 2-2z',
  home: 'M3 10.5L12 3l9 7.5M5.5 8.8V20h13V8.8M9.8 20v-6h4.4v6',
  clinic: 'M4 20V6.5L12 3l8 3.5V20M4 20h16M12 8v6M9 11h6',
  message: 'M21 12a8 8 0 0 1-8 8H4l1.7-3.4A8 8 0 1 1 21 12z',
  file: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5zM14 3v5h5M9 13h6M9 17h6',
  rx: 'M7 4h5a3.5 3.5 0 0 1 0 7H7V4zM7 11v9M10 13l7 7M17 13l-7 7',
};
---
<Base title="How it works · Direct Lifestyle Medicine" active="how" bookbar={true}>

  <!-- 1 · Intro -->
  <section class="page-title">
    <div class="container">
      <h1>How it works</h1>
    </div>
  </section>

  <!-- 2 · First 90 days -->
  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>The first 90 days</h2>
        </div>
        <div class="timeline">
          <div class="tl-item">
            <h3>Free conversation</h3>
            <p>30 minutes by video.</p>
          </div>
          <div class="tl-item">
            <h3>Weeks 1&ndash;2: first visit</h3>
            <p>I read your records first. The visit is up to 90 minutes.</p>
          </div>
          <div class="tl-item">
            <h3>Weeks 2&ndash;4: tests</h3>
            <p>Screenings and labs as needed. I tell you the cash price
            first, or we use your insurance.</p>
          </div>
          <div class="tl-item">
            <h3>Week 4: written plan</h3>
            <p>In your portal.</p>
          </div>
          <div class="tl-item">
            <h3>After that</h3>
            <p>Visits as often as you need. We review at 90 days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Where we meet -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <h2>Where we meet</h2>
      </div>
      <div class="cards c3">
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.video} /></svg>
          </div>
          <h4>By video</h4>
          <p>Most visits.</p>
        </div>
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.home} /></svg>
          </div>
          <h4>At your home</h4>
          <p>When an exam needs it, within my service area. No extra
          charge.</p>
        </div>
        <div class="card">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.clinic} /></svg>
          </div>
          <h4>In a clinic</h4>
          <p>For procedures and exams that need equipment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Between visits -->
  <section class="section band-tint" id="bookbar-after">
    <div class="container">
      <div class="sec-head">
        <h2>Between visits</h2>
      </div>
      <div class="steps c3">
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.message} /></svg>
          </div>
          <h4>Messages</h4>
          <p>Through the portal. Answered within 1&ndash;2 business days.</p>
        </div>
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.file} /></svg>
          </div>
          <h4>Results</h4>
          <p>Each one comes with my note.</p>
        </div>
        <div class="step-item">
          <div class="icon-chip">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.rx} /></svg>
          </div>
          <h4>Refills</h4>
          <p>Renewed at visits.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Availability -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>Hours</h2>
        </div>
        <div class="prose">
          <p>
            Business hours, Monday to Friday. No nights or weekends.
          </p>
          <p>
            I take time away each year, with notice. I still check results
            and messages. Away means slower, never unaware.
          </p>
          <EmergencyStrip />
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · CTA -->
  <section class="section cta-band">
    <div class="container">
      <div class="inner">
        <a class="btn btn-inverse" href="/book">Book a free conversation</a>
      </div>
    </div>
  </section>

</Base>
