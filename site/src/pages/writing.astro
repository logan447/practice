---
import Base from '../layouts/Base.astro';
// Public writing home. Articles will be Astro content collections
// (markdown in this repo) when they exist; this page is the stable URL
// and the newsletter's home. Public newsletter stays separate from
// patient and clinical communications by design (see site README).
---
<Base title="Writing · DuBose, M.D.">
  <section class="page-title">
    <div class="container">
      <span class="eyebrow">Writing</span>
      <h1>Articles</h1>
      <p class="lede">Plain-language articles on primary care, prevention, and aging.</p>
    </div>
  </section>
  <section class="section tight band-warm">
    <div class="container">
      <div class="prose">
        <p>
          New articles will appear here. To get them by email, use the
          letter signup in the footer.
        </p>
        <p style="margin-top:20px">
          <a class="quiet" href="/about">My research and background &rarr;</a>
          <br /><a class="quiet" href="/cv">Full CV and publication list &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</Base>
