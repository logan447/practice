---
import Base from '../layouts/Base.astro';
// For referring clinicians. Direct URL for outreach materials and QR
// codes; linked from the footer, deliberately not in the main
// navigation. Tone: complementary, never competitive.
---
<Base title="For referring clinicians · Direct Lifestyle Medicine">

  <section class="page-title">
    <div class="container">
      <h1>For referring clinicians</h1>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>Patients I can help</h2>
        </div>
        <div class="prose">
          <p>
            Adults with cardiometabolic risk, prediabetes, diabetes,
            hypertension, obesity, or several chronic conditions who need
            sustained lifestyle work and follow-up between your visits.
          </p>
          <p>
            $99 a month, direct pay. Reduced-fee and pro bono memberships
            get the same care.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>Working with you</h2>
        </div>
        <div class="prose">
          <p>
            Your care stays yours. I add lifestyle work, follow-up,
            medication reconciliation, and coordination, and refer back
            rather than duplicate. With the patient&rsquo;s permission, I
            send you a summary after the first visit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>How to refer</h2>
        </div>
        <div class="prose">
          <p>
            Have the patient book a free conversation. To reach me first,
            use the <a href="/contact">contact form</a>.
          </p>
          <div class="cta-row">
            <a class="btn" href="/book">Book a free conversation</a>
            <a class="quiet" href="/cv">CV &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
