---
import Base from '../layouts/Base.astro';
// For referring clinicians. Direct URL for outreach materials and QR
// codes; linked from the footer, deliberately not in the main
// navigation. Tone: complementary, never competitive.
---
<Base title="For referring clinicians · Direct Lifestyle Medicine">

  <section class="page-title">
    <div class="container">
      <h1>For referring clinicians</h1>
      <p class="lede">
        I&rsquo;m Logan DuBose, M.D. I run Direct Lifestyle Medicine, a
        membership practice in [City], Texas focused on prevention and
        lifestyle medicine. Thank you for considering me for your
        patient.
      </p>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>Patients I can help</h2>
        </div>
        <div class="prose">
          <p>
            Adults who would benefit from sustained work on nutrition,
            weight, activity, sleep, stress, alcohol, or tobacco, and
            from close follow-up between your visits. Often that is
            cardiometabolic risk, prediabetes and diabetes, hypertension,
            obesity, or several chronic conditions at once. I see
            patients by video, at home when an exam needs it, and in
            clinic. Membership is $99 a month, paid directly, alongside
            their insurance and their current physicians, including you.
            Reduced-fee and pro bono memberships are available when cost
            is the barrier.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>How we work together</h2>
        </div>
        <div class="prose">
          <p>
            Your care stays yours. I provide the prevention and
            lifestyle layer around it, plus follow-up between your
            visits, medication reconciliation, monitoring, and
            coordination. I treat within my scope and refer back rather
            than duplicate your work. With the patient&rsquo;s
            permission, I send you a summary after the first visit and
            keep you informed of relevant changes. Patients without a
            primary care physician are also welcome, and I help them
            establish one when they need it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>How to refer</h2>
        </div>
        <div class="prose">
          <p>
            Give your patient this site, or have them book a free
            30-minute conversation directly. It needs only their name,
            email, and phone, and they do not have to join. To reach me
            first, use the <a href="/contact">contact form</a>. I reply
            within two business days.
          </p>
          <div class="cta-row">
            <a class="btn" href="/book">Book a free conversation</a>
            <a class="quiet" href="/about">My background and credentials &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
