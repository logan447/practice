---
import Base from '../layouts/Base.astro';
// For referring clinicians. Direct URL for outreach materials and QR
// codes; linked from the footer, deliberately not in the main
// navigation. Tone: complementary, never competitive.
---
<Base title="For referring clinicians · DuBose, M.D.">

  <section class="page-title">
    <div class="container">
      <h1>For referring clinicians</h1>
      <p class="lede">
        I&rsquo;m Logan DuBose, M.D., a direct primary care physician in
        [City], Texas. Thank you for considering me for your patient.
      </p>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>Patients I can help</h2>
        </div>
        <div class="prose">
          <p>
            Adults who need ongoing primary care with close follow-up:
            multiple chronic conditions, medication management,
            prevention and lifestyle change, or frequent touchpoints
            between your visits. I see patients by video, at home when an
            exam needs it, and in clinic. Membership is $100 a month,
            direct pay, alongside their existing insurance and their
            existing physicians, including you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>How we work together</h2>
        </div>
        <div class="prose">
          <p>
            Your care stays yours. I provide the primary care layer
            around it: follow-up between your visits, medication
            reconciliation, monitoring, and coordination. With the
            patient&rsquo;s permission, I send you a summary after the
            first visit and keep you informed of relevant changes. I
            refer back readily and do not duplicate your work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-warm">
    <div class="container">
      <div class="split">
        <div>
          <h2>How to refer</h2>
        </div>
        <div class="prose">
          <p>
            Give your patient this site, or have them book a free
            30-minute conversation directly: no forms, no commitment. To
            reach me first, use the <a href="/contact">contact form</a>
            and I&rsquo;ll respond within two business days.
          </p>
          <div class="cta-row">
            <a class="btn" href="/book">Patient booking page</a>
            <a class="quiet" href="/about">My background and credentials &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
