---
import Base from '../layouts/Base.astro';
---
<Base title="What I help with · Direct Lifestyle Medicine" active="help" bookbar={true}>

  <!-- 1 · Intro -->
  <section class="page-title">
    <div class="container">
      <h1>What I help with</h1>
    </div>
  </section>

  <!-- 2 · Prevention and lifestyle medicine -->
  <section class="section band-tint">
    <div class="container">
      <div class="sec-head">
        <h2>Prevention and lifestyle medicine</h2>
        <p class="lede">Every member starts here.</p>
      </div>
      <div class="steps c3">
        <div class="step-item"><h4>Nutrition and metabolic health</h4></div>
        <div class="step-item"><h4>Activity</h4></div>
        <div class="step-item"><h4>Sleep</h4></div>
        <div class="step-item"><h4>Stress</h4></div>
        <div class="step-item"><h4>Relationships</h4></div>
        <div class="step-item"><h4>Alcohol and tobacco</h4></div>
      </div>
    </div>
  </section>

  <!-- 3 · Medical care -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <h2>Medical care</h2>
        <p class="lede">When tests or treatment are needed, I use them.</p>
      </div>
      <div class="rows">
        <div class="row">
          <b>Conditions</b>
          <p>High blood pressure, diabetes, prediabetes, cholesterol,
          thyroid, obesity, acid reflux. Some conditions need a
          specialist leading.</p>
        </div>
        <div class="row">
          <b>Medicines</b>
          <p>Started, adjusted, stopped, and monitored, including
          weight-loss medicines.</p>
        </div>
        <div class="row">
          <b>Labs and imaging</b>
          <p>Ordered and explained.</p>
        </div>
        <div class="row">
          <b>Everyday illness</b>
          <p>Infections, rashes, stomach trouble, minor injuries, when I
          am available.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Care coordination -->
  <section class="section band-warm" id="bookbar-after">
    <div class="container">
      <div class="sec-head">
        <h2>Care coordination</h2>
      </div>
      <div class="rows">
        <div class="row">
          <b>Your other doctors</b>
          <p>With your permission, I keep them informed. You do not have
          to choose.</p>
        </div>
        <div class="row">
          <b>Referrals</b>
          <p>I refer you and stay involved.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · What I don't do -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2>What I don&rsquo;t do</h2>
        </div>
        <div class="rows" style="margin-top:0">
          <div class="row"><b>Emergencies</b><p>Call 911.</p></div>
          <div class="row"><b>Hospital care</b><p>I follow up after.</p></div>
          <div class="row"><b>Specialist-led conditions</b><p>I refer.</p></div>
          <div class="row"><b>Serious psychiatric illness or addiction</b><p>I refer.</p></div>
          <div class="row"><b>Children</b><p>Adults only.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · CTA -->
  <section class="section cta-band">
    <div class="container">
      <div class="inner">
        <h2>Not sure if you fit?</h2>
        <a class="btn btn-inverse" href="/book">Book a free conversation</a>
      </div>
    </div>
  </section>

</Base>
